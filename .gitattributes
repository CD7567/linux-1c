# Auto detect text files
* text=auto

# Linux scripts should use lf
gradlew        text eol=lf
*.sh           text eol=lf

# Windows scripts should use crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Unix / kernel development files should use lf
*.c            text eol=lf diff=cpp
*.h            text eol=lf diff=cpp
Makefile       text eol=lf
*.mk           text eol=lf
Kbuild         text eol=lf
Kconfig        text eol=lf
*.sh           text eol=lf
*.py           text eol=lf
*.pl           text eol=lf

# Common config and docs
*.md           text eol=lf
*.txt          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.toml         text eol=lf
*.conf         text eol=lf
*.cfg          text eol=lf

# Binary files
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.pdf          binary
*.zip          binary
*.tar          binary
*.gz           binary
*.xz           binary
*.bz2          binary
*.ko           binary
